{
  "name": "shaun-tucker-website",
  "compatibility_date": "2026-08-04",
  "main": "src/worker.js",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "shauntucker.com.au", "custom_domain": true },
    { "pattern": "www.shauntucker.com.au", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
